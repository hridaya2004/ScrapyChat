{
  "name": "auth",
  "private": true,
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "build": "bun build --compile --minify-whitespace --minify-syntax --outfile=server ./src/index.ts",
    "dev": "bun --hot run ./src/server.ts",
    "migrate": "bun run ./src/db/repair-schema.ts && bunx --bun auth migrate --yes --config ./src/lib/auth.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/openapi": "^1.4.16",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "elysia": "1.4.30",
    "mysql2": "^3.24.5",
    "node-gyp": "^13.0.2",
    "nodemailer": "^10.0.13"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "auth": "^1.7.6",
    "tsx": "^4.23.15"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.3.14"
}
