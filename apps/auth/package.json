{
  "name": "auth",
  "private": true,
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "build": "bun build --compile --minify-whitespace --minify-syntax --outfile=server ./src/index.ts",
    "dev": "bun --hot run ./src/server.ts",
    "migrate": "bun run ./src/db/repair-schema.ts && bunx --bun auth migrate --yes --config ./src/lib/auth.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.3",
    "@elysiajs/openapi": "^1.4.17",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.83.1",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.301.2",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@opentelemetry/sdk-trace-node": "^2.12.1",
    "elysia": "1.4.32",
    "mysql2": "^3.24.6",
    "node-gyp": "^13.1.0",
    "nodemailer": "^10.5.0"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "auth": "^1.7.24",
    "tsx": "^4.23.15"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.3.14"
}
